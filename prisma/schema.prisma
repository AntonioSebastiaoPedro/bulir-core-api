generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  PROVIDER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  nif       String   @unique
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  // Dinheiro nunca em Float: Decimal evita erros de arredondamento.
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
  bookings Booking[]

  @@map("users")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(12, 2)
  providerId  String
  provider    User     @relation(fields: [providerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([providerId])
  @@map("services")
}

model Booking {
  id        String        @id @default(uuid())
  clientId  String
  client    User          @relation(fields: [clientId], references: [id])
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  // Valor pago no momento da reserva (o preço do serviço pode mudar depois).
  amount    Decimal       @db.Decimal(12, 2)
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@index([serviceId])
  @@map("bookings")
}
